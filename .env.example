# ==============================================================================
# Sales CRM Environment Variables Template
# ==============================================================================

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/salescrm?retryWrites=true&w=majority

# App URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM / AI Inference (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Lead Scraper (Apify Google Maps Scraper - Optional)
NEXT_PUBLIC_APIFY_TOKEN=

# Outbound Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Sales Team" <your_email@gmail.com>
SMTP_FROM_NAME="Sales Team"

# Inbound Email Sync (IMAP - Optional)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password

# Security & Cron Secrets
CRON_SECRET=your_cron_secret_here
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_secret_here

# Public HTTPS URL Plivo can reach (ngrok URL in dev, your domain in prod).
# Required for AI calls: answer/hangup callbacks and the /ws/plivo media stream.
PUBLIC_APP_URL=https://your-subdomain.ngrok-free.app

# Voice Calls (Plivo telephony + ElevenLabs Conversational AI)
# Run the app with `npm run dev:ngrok` / `npm run dev:bridge` (or `npm run start:bridge`)
# so the /ws/plivo bridge is served — plain `next dev` cannot place AI calls.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Timezone for the calling-hours window in Settings (default Asia/Kolkata)
CALL_TIMEZONE=Asia/Kolkata

# ── Sessions & access ─────────────────────────────────────────────
# Signs login cookies. Required in production — any random string, 32+ characters.
AUTH_SECRET=
# Comma-separated emails with superadmin access.
SUPERADMIN_EMAILS=admin@salesagent.ai

# ── Payments (prepaid 30-day plans) ───────────────────────────────
# Set to "fake" to instantly activate subscriptions directly without Razorpay (for testing/development)
# Set to "real" to require real Razorpay payment
PAYMENT_MODE=fake

# Dashboard → Account & Settings → API Keys (use test keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<your-domain>/api/webhooks/razorpay,
# events payment.captured, order.paid, payment.failed — paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=
